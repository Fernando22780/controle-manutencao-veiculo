{
  "expo": {
    "name": "Controle de Manutenção de Veículos",
    "slug": "controle-manutencao-veiculo-final",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/app-icon.png",
    "splash": {
      "image": "./assets/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#042D21"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.controledemanutencaoveiculo.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use a biometria para proteger o acesso ao aplicativo."
      }
    },
    "android": {
      "package": "com.controledemanutencaoveiculo.app",
      "adaptiveIcon": {
        "backgroundColor": "#071F1B",
        "foregroundImage": "./assets/app-icon.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para fotografar o comprovante."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita o acesso à localização para registrar a oficina."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para escolher uma foto de perfil.",
          "cameraPermission": "Permita o acesso à câmara para tirar uma foto de perfil."
        }
      ],
      "expo-local-authentication",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-notifications"
    ]
  }
}
